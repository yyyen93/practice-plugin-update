{
  "name": "howard/practice-plugin-update",
  "description": "Practice project for updating a WordPress plugin via Composer and Git.",
  "type": "project",
  "require": {
    "php": "^8.0",
    "wpackagist-plugin/contact-form-7": "^6.1.4",
    "wpackagist-plugin/wordpress-seo": "^22.9"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://wpackagist.org"
    }
  ],
  "config": {
    "allow-plugins": {
      "composer/installers": true
    }
  }
}
