{
  "name": "howard/practice-plugin-update",
  "description": "Practice project for updating a WordPress plugin via Composer and Git.",
  "type": "project",
  "require": {
    "php": "^8.0",
    "wpackagist-plugin/contact-form-7": "^6.1.4",
    "wpackagist-plugin/wordpress-seo": "^22.9",
    "wpackagist-plugin/classic-editor": "^1.6.7",
    "wpackagist-plugin/wordfence": "^8.1.3",
    "wpackagist-plugin/woocommerce": "^8.9.3",
    "wpackagist-plugin/akismet": "^4.0",
    "wpackagist-plugin/really-simple-ssl": "^9.4.0",
    "wpackagist-plugin/wpforms-lite": "^1.8"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://wpackagist.org"
    }
  ],
  "config": {
    "allow-plugins": {
      "composer/installers": true
    }
  }
}
